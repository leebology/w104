# Copy to .env only if you want the local web app to talk to the DEPLOYED
# server instead of a local one. Normally you don't need this file — the app
# falls back to 127.0.0.1:8787 (the `wrangler dev` / `npm run dev:party` port).
#
# In production this value is set in the Vercel project settings, NOT here.
VITE_PARTYKIT_HOST=w104.liam-donaher.workers.dev
