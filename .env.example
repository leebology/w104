# Copy to .env for local dev only if you want to point the web app at a
# deployed PartyKit server instead of the local one. Normally you don't need
# this file locally — the app falls back to 127.0.0.1:1999 (`npm run dev:party`).
#
# In production this value is set in the Vercel project settings, NOT here.
VITE_PARTYKIT_HOST=w104.leebology.partykit.dev
