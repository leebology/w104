{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "w104",
  "main": "party/server.ts",
  "compatibility_date": "2026-07-25",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  // Read by the /debug/usage endpoint only, and neither value gates it — the
  // panel is live in every environment. ENVIRONMENT is the label in the
  // panel's footer; WORKER_NAME is what the Workers request count filters on,
  // so getting it wrong reports the other Worker's traffic.
  //
  // `wrangler dev` reads THIS block rather than an empty one, which is why
  // `npm run dev:party` passes `--var ENVIRONMENT:local` over the top.
  //
  // The two secrets the endpoint also wants (CF_API_TOKEN, CF_ACCOUNT_ID) are
  // NOT here — see HOSTING.md.
  "vars": {
    "ENVIRONMENT": "production",
    "WORKER_NAME": "w104"
  },
  // The realtime room server. Each room is one Durable Object instance.
  "durable_objects": {
    "bindings": [{ "name": "W104", "class_name": "W104" }]
  },
  // `new_sqlite_classes` (not `new_classes`) is required for Durable Objects on
  // the Cloudflare free plan. Do not change to new_classes — it needs a paid plan.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["W104"] }],
  // Named environments do NOT inherit durable_objects bindings from the
  // top level, so it must be repeated here. Migrations are top-level and
  // apply to every environment already, so they are not repeated.
  "env": {
    "staging": {
      "name": "w104-staging",
      "workers_dev": true,
      "observability": { "enabled": true },
      // `vars` is not inherited either, and leaving WORKER_NAME behind would
      // silently count the production Worker's requests on the staging panel.
      "vars": {
        "ENVIRONMENT": "staging",
        "WORKER_NAME": "w104-staging"
      },
      "durable_objects": {
        "bindings": [{ "name": "W104", "class_name": "W104" }]
      }
    }
  }
}
