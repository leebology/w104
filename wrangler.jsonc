{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "w104",
  "main": "party/server.ts",
  "compatibility_date": "2026-07-25",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  // Read by the /debug/usage endpoint only, and it gates nothing — the panel
  // is live in every environment. This is purely the label in the panel's
  // footer, so a tab left open against the wrong Worker is obvious.
  //
  // `wrangler dev` reads THIS block rather than an empty one, which is why
  // `npm run dev:party` passes `--var ENVIRONMENT:local` over the top.
  //
  // The two secrets the endpoint also wants (CF_API_TOKEN, CF_ACCOUNT_ID) are
  // NOT here — see HOSTING.md. The Worker *names* the usage panel breaks
  // requests down by are the `name` fields below, mirrored in WORKER_SCRIPTS
  // in party/usage.ts.
  "vars": {
    "ENVIRONMENT": "production"
  },
  // The realtime room server. Each room is one Durable Object instance.
  "durable_objects": {
    "bindings": [{ "name": "W104", "class_name": "W104" }]
  },
  // The score archive. Written after each round and at match end; NEVER read
  // by the game — see docs/superpowers/specs/2026-07-28-score-persistence-design.md.
  // The binding is `DB` in every environment so no code branches on which one
  // it is; only the database behind it differs.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "w104-archive",
      "database_id": "a2188b6c-4a44-4505-940a-45bc554352b6",
      "migrations_dir": "migrations"
    }
  ],
  // Per-IP budget on room connects, so the four-letter code space cannot be
  // walked to enumerate live lobbies — see `rateLimited` in party/server.ts for
  // what this does and does not buy.
  //
  // `namespace_id` is the counter's identity: any binding anywhere in the
  // account sharing this number shares its counters. Staging therefore uses a
  // DIFFERENT one below, or an afternoon of phone testing would spend the
  // budget real players are using. `period` accepts only 10 or 60.
  "ratelimits": [
    {
      "name": "JOIN_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 }
    }
  ],
  // `new_sqlite_classes` (not `new_classes`) is required for Durable Objects on
  // the Cloudflare free plan. Do not change to new_classes — it needs a paid plan.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["W104"] }],
  // Named environments do NOT inherit durable_objects, d1_databases or
  // ratelimits bindings from the top level, so all three must be repeated here.
  // Migrations are top-level and apply to every environment already, so they
  // are not repeated. Omitting the D1 block would not fail the deploy — it
  // would fail at the first archive write, in production-shaped traffic.
  "env": {
    "staging": {
      "name": "w104-staging",
      "workers_dev": true,
      "observability": { "enabled": true },
      // `vars` is not inherited either, so an omitted ENVIRONMENT here would
      // label the staging panel "production".
      "vars": {
        "ENVIRONMENT": "staging"
      },
      "durable_objects": {
        "bindings": [{ "name": "W104", "class_name": "W104" }]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "w104-staging-archive",
          "database_id": "a7d51d00-5226-4c12-99d9-ccecb6d6ddc3",
          "migrations_dir": "migrations"
        }
      ],
      // 1002, not 1001: counters are shared by namespace_id across the whole
      // account, so reusing production's would have three phones on a sofa
      // eating into the budget of the people actually playing.
      "ratelimits": [
        {
          "name": "JOIN_LIMITER",
          "namespace_id": "1002",
          "simple": { "limit": 60, "period": 60 }
        }
      ]
    }
  }
}
